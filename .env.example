# Public browser credentials from Supabase Project Settings > API.
# The anon key is safe in the frontend when Row Level Security is enabled.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Existing optional call-scanner backend.
VITE_CALL_SCANNER_API_URL=https://your-railway-service.up.railway.app
