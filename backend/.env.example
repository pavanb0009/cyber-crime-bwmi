# large-v3-turbo is the default: clearly the best Hindi/Hinglish accuracy, and
# faster than "small" in practice because it decodes with fewer layers.
# Drop to "small" only if disk space or RAM is tight; Hindi output degrades a lot.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
