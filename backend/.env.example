# Railway — use Groq (free). Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Exact frontend origins, comma-separated, no trailing slash.
# Add your custom Vercel domain. *.vercel.app previews are already allowed.
CORS_ORIGINS=https://your-custom-domain.com

# Groq defaults (change only if a model name is retired)
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_ANALYSIS_MODEL=llama-3.1-8b-instant

# Optional paid OpenAI instead of Groq
# OPENAI_API_KEY=
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini
